{
  "name": "erp-modular",
  "private": true,
  "version": "0.0.1",
  "description": "ERP modular — nucleo Admin + modulos independientes (Inventario, Ventas, Proveedores, Contabilidad)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @erp/core prisma generate",
    "db:push": "pnpm --filter @erp/core prisma db push",
    "db:migrate:deploy": "pnpm --filter @erp/core prisma migrate deploy"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=20"
  }
}
