# Base de datos (Supabase Postgres)
# Runtime normal -> Transaction pooler (puerto 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# prisma migrate / db push -> Session pooler (puerto 5432). Nunca usar el mismo puerto para ambos.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# Supabase Storage
SUPABASE_STORAGE_BUCKET_PUBLIC="public-assets"
SUPABASE_STORAGE_BUCKET_PRIVATE="private-evidence"

# Auth
SUPABASE_AUTH_JWT_SECRET="..."

# Fase 0: sin proveedor de pago aun (soporte mensual se registra manualmente en OrganizationModule)

# Cron del outbox (apps/web/app/api/cron/dispatch-events, ver apps/web/vercel.json)
# Vercel agrega este valor automáticamente como header Authorization al llamar
# el cron cuando la variable está configurada en Project Settings -> Environment
# Variables. En local es opcional (el endpoint se abre sin secreto solo si
# NODE_ENV no es "production"), pero en producción es obligatorio.
CRON_SECRET="..."
